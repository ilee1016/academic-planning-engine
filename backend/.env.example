# Backend environment variables
# Copy to .env.local for local overrides (never commit .env.local)

# CORS: comma-separated list of allowed frontend origins
# Default (unset): http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# AI explanation provider ("none" = deterministic fallback only, no API cost)
EXPLANATION_PROVIDER=none

# Required only when EXPLANATION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# ANTHROPIC_EXPLANATION_MODEL=claude-haiku-4-5-20251001
# EXPLANATION_TIMEOUT_SECONDS=8
# EXPLANATION_CACHE_SIZE=500
